# NOD CRM — environment file.
#
#   cp .env.example .env      (or run ./scripts/init-env.sh, which also
#                              generates the two secrets for you)
#   chmod 600 .env
#
# `.env` is git-ignored and must never be committed. Every value below is a
# placeholder: replace the two secrets before exposing NOD CRM to anyone.

# --- PostgreSQL -------------------------------------------------------------
# Used by the `postgres` container and to build DATABASE_URL in
# docker-compose.yml. The database publishes no port: this password only
# guards access from inside the Docker network, but it must still be strong
# and specific to NOD CRM.
#
#   Generate:  openssl rand -base64 36 | tr -d '/+=' | cut -c1-40
#
# REQUIRED
POSTGRES_USER=nodcrm
POSTGRES_PASSWORD=change-me-a-long-random-password
POSTGRES_DB=nod_crm

# --- Authentication ---------------------------------------------------------
# HMAC pepper for session tokens: the database only ever stores
# HMAC-SHA256(token, AUTH_SECRET), so a database leak alone cannot forge a
# valid cookie. Changing it logs everyone out. Minimum 32 characters.
#
#   Generate:  openssl rand -base64 48
#
# REQUIRED (the application refuses to start in production without it)
AUTH_SECRET=change-me-with-a-long-random-secret

# --- Application ------------------------------------------------------------
# Name shown in the UI. Read at runtime, so renaming an instance does not
# require rebuilding the image.
# OPTIONAL — default: NOD CRM
APP_NAME=NOD CRM

# Link behind the "Source" entry in the sidebar. NOD CRM is licensed under the
# AGPL-3.0: if you MODIFY it and let other people use your instance over a
# network, section 13 requires you to offer them the corresponding source.
# Point this at YOUR repository in that case.
# OPTIONAL — default: the upstream repository
APP_SOURCE_URL=https://github.com/ious2944/nod-crm

# Time zone used for day-level reasoning (due dates, "+3 days", overdue).
# The server may run in UTC; "today" must not depend on that.
# Any IANA name: Europe/Paris, America/New_York, UTC…
# OPTIONAL — default: Europe/Paris
APP_TIME_ZONE=Europe/Paris

# Host port NOD CRM is published on.
# OPTIONAL — default: 3000
APP_HOST_PORT=3000

# Address the port is bound to. `127.0.0.1` keeps NOD CRM off the network:
# a reverse proxy terminating HTTPS is the only intended entry point.
# Set it to 0.0.0.0 only if you know what you are exposing — session cookies
# are `Secure` in production and will NOT be sent over plain HTTP, so a
# directly exposed instance cannot be logged into.
# OPTIONAL — default: 127.0.0.1
APP_BIND_ADDRESS=127.0.0.1

# --- Contact photos ---------------------------------------------------------
# Directory holding uploaded contact photos. Images are NEVER stored in
# PostgreSQL: the database keeps an opaque key, the bytes live here. The
# directory sits outside the web root, and every read goes through an
# authenticated route that re-checks the workspace.
#
# The Docker stack sets this to /app/var/uploads and mounts a named volume on
# it — back that volume up together with the database, since the rows point at
# these files.
# OPTIONAL — default: <project>/var/uploads (used when running outside Docker)
# NOD_UPLOAD_DIR=/app/var/uploads

# --- Docker volumes ---------------------------------------------------------
# Name of the Docker volume holding PostgreSQL data. Change it only to adopt
# an existing volume: pointing this at a different name starts from an EMPTY
# database, it does not migrate anything.
# OPTIONAL — default: nod-crm-postgres-data
POSTGRES_VOLUME_NAME=nod-crm-postgres-data

# Name of the Docker volume holding contact photos. Same warning: a different
# name starts from an EMPTY directory, and existing contacts would then point
# at files that are not there.
# OPTIONAL — default: nod-crm-uploads-data
UPLOADS_VOLUME_NAME=nod-crm-uploads-data

# --- Local development only -------------------------------------------------
# Direct PostgreSQL connection string, used when you run the application on
# your machine instead of in Docker (`npm run dev`, `npm run db:migrate`).
# The Docker stack builds its own DATABASE_URL from POSTGRES_* above and
# ignores this line.
# OPTIONAL outside local development
DATABASE_URL="postgresql://nodcrm:change-me-a-long-random-password@127.0.0.1:5432/nod_crm?schema=public"

# Separate database for the integration test suite. It TRUNCATES tables
# between files, so it must never point at a database you care about.
# OPTIONAL — required only for `npm run test:integration`
# TEST_DATABASE_URL="postgresql://nodcrm:change-me@127.0.0.1:5432/nod_crm_test?schema=public"
