# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# env : on ne versionne que le modèle. `.env*` ci-dessus attrape tout, y
# compris `.env.example` : sans cette négation, le seul fichier que quelqu'un
# doit pouvoir lire avant d'installer NOD CRM ne serait pas dans le dépôt.
!.env.example

# outils locaux
/.claude/settings.local.json

# secrets — jamais versionnés. `.env.prod` est conservé ici même si le dépôt
# public n'en produit aucun : ceux qui déploient en gardent un, et une règle
# d'ignore qui ne coûte rien vaut mieux qu'un secret poussé par mégarde.
.env.prod
.env.*.local
*.pem
*.key

# dumps de base
/backups
*.sql.gz
