// NOD CRM — schéma
// Périmètre : Workspace / Organization / Contact / FollowUp / Task.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FollowUpStatus {
  OPEN
  COMPLETED
  ABANDONED
}

enum BallOwner {
  ME
  THEM
}

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  contacts      Contact[]
  followUps     FollowUp[]
  organizations Organization[]
  tasks         Task[]
  users         User[]

  @@map("workspaces")
}

/// Un utilisateur appartient à exactement un workspace. Le workspace autorisé
/// est donc entièrement déterminé par la session : il n'est jamais lu depuis
/// une entrée client.
model User {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  email        String    @unique
  /// Argon2id. Ne jamais journaliser, ne jamais renvoyer au client.
  passwordHash String    @map("password_hash")
  displayName  String?   @map("display_name")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessions  Session[]

  @@index([workspaceId])
  @@map("users")
}

/// Session opaque côté serveur. Le cookie ne transporte qu'un jeton aléatoire ;
/// la base ne stocke que son HMAC-SHA256 (clé = AUTH_SECRET). Une fuite de la
/// base seule ne permet donc pas de forger un cookie valide.
model Session {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  /// Expiration absolue : la session meurt même si elle reste active.
  expiresAt     DateTime  @map("expires_at")
  /// Expiration d'inactivité, repoussée au fil des requêtes.
  idleExpiresAt DateTime  @map("idle_expires_at")
  lastUsedAt    DateTime  @default(now()) @map("last_used_at")
  revokedAt     DateTime? @map("revoked_at")
  /// Contexte de création, à des fins de détection d'abus. L'IP est hachée.
  userAgent     String?   @map("user_agent")
  ipHash        String?   @map("ip_hash")
  createdAt     DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Tentatives de connexion, pour la limitation de débit applicative.
/// Aucun mot de passe n'y est stocké ; l'IP est hachée.
model LoginAttempt {
  id         String   @id @default(uuid()) @db.Uuid
  /// Clé de comptage : `email:<adresse>` ou `ip:<empreinte>`.
  scope      String
  successful Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([scope, createdAt])
  @@map("login_attempts")
}

/// Référentiel des entreprises, sociétés et associations (V0.5).
///
/// Une organisation est un contexte au-dessus du contact. Elle n'impose rien :
/// un contact peut n'en avoir aucune, et une organisation peut exister sans
/// contact rattaché.
///
/// **Isolation.** `workspace_id` est obligatoire et jamais lu depuis une entrée
/// client : toute requête le dérive de la session, ce qui rend structurellement
/// impossible de lire ou modifier une organisation d'un autre workspace.
///
/// **Archivage.** Comme pour les contacts : aucune suppression destructive.
/// Une organisation archivée n'apparaît plus dans la liste ni dans le sélecteur,
/// mais les contacts rattachés restent valides et conservent leur lien.
model Organization {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  name        String
  website     String?
  phone       String?
  email       String?
  notes       String?
  archivedAt  DateTime? @map("archived_at")
  isDemo      Boolean   @default(false) @map("is_demo")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts  Contact[]

  @@index([workspaceId, archivedAt, name])
  @@map("organizations")
}

/// Référentiel central des personnes (V0.2).
///
/// Un contact existe indépendamment de tout suivi : c'est lui le référentiel,
/// pas le Follow-Up. La relation `follow_ups.contact_id` reste facultative.
///
/// **Organisation (V0.5).** `organization_id` est une FK nullable vers la table
/// `organizations`. Le champ texte `organization_name` est conservé pour la
/// rétrocompatibilité : les contacts antérieurs à la migration restent valides,
/// et les affichages l'utilisent en dernier recours. Conformément au plan de
/// migration documenté dans `docs/contacts.md`, `organization_name` ne sera
/// retiré que dans une version ultérieure, une fois que tous les contacts
/// auront été backfillés et que les lectures auront été migrées.
model Contact {
  id               String    @id @default(uuid()) @db.Uuid
  workspaceId      String    @map("workspace_id") @db.Uuid
  organizationId   String?   @map("organization_id") @db.Uuid
  firstName        String    @map("first_name")
  lastName         String    @map("last_name")
  email            String?
  phone            String?
  jobTitle         String?   @map("job_title")
  /// Conservé pour rétrocompatibilité. Lorsque `organization_id` est renseigné,
  /// `organization_name` reflète le nom au moment du rattachement et peut dériver.
  /// Il sert de valeur d'affichage de secours si l'organisation est supprimée.
  organizationName String?   @map("organization_name")
  notes            String?
  /// Clé opaque dans le magasin d'objets (`src/lib/storage`), jamais un chemin
  /// choisi par l'utilisateur. L'image elle-même n'est PAS stockée en base.
  photoKey         String?   @map("photo_key")
  /// Type MIME **constaté** à l'upload (octets d'en-tête), pas celui annoncé.
  photoMimeType    String?   @map("photo_mime_type")
  /// Archivage logique : aucune suppression destructive, et les suivis liés
  /// sont conservés tels quels.
  archivedAt       DateTime? @map("archived_at")
  isDemo           Boolean   @default(false) @map("is_demo")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  followUps    FollowUp[]
  tasks        Task[]

  // Les trois index suivent les trois tris proposés par la liste Contacts, et
  // commencent tous par le couple réellement filtré (`workspace_id`,
  // `archived_at`) : sans `archived_at` en tête, PostgreSQL filtrait les
  // archivés après avoir trié.
  @@index([workspaceId, archivedAt, firstName, lastName])
  @@index([workspaceId, archivedAt, createdAt])
  @@index([workspaceId, archivedAt, updatedAt])
  @@index([organizationId])
  @@map("contacts")
}

model FollowUp {
  id          String         @id @default(uuid()) @db.Uuid
  workspaceId String         @map("workspace_id") @db.Uuid
  contactId   String?        @map("contact_id") @db.Uuid
  title       String
  description String?
  status      FollowUpStatus @default(OPEN)
  ballOwner   BallOwner      @default(THEM) @map("ball_owner")
  dueAt       DateTime       @map("due_at")
  // Une « relance » n'envoie rien en V0.1 : elle est simplement matérialisée ici.
  nudgeCount  Int            @default(0) @map("nudge_count")
  lastNudgedAt DateTime?     @map("last_nudged_at")
  isDemo      Boolean        @default(false) @map("is_demo")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  completedAt DateTime?      @map("completed_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  tasks     Task[]

  @@index([workspaceId, status, dueAt])
  @@index([contactId])
  @@map("follow_ups")
}

/// Une tâche (V0.4) : **quelque chose à faire**.
///
/// À ne pas confondre avec un suivi, qui est **quelque chose à faire avancer
/// avec quelqu'un**. C'est toute la distinction du module : une tâche n'a ni
/// balle, ni relance, ni interlocuteur obligatoire. Elle peut rester seule,
/// citer un contact pour le contexte, ou pointer un suivi — sans qu'aucun de
/// ces liens ne synchronise les états (terminer l'un ne termine jamais
/// l'autre).
///
/// **États.** Deux, et pas un de plus : `completed_at IS NULL` (à faire) ou
/// non (terminée). Ni priorité, ni statut intermédiaire, ni workflow.
///
/// **Cloisonnement.** `workspace_id` est obligatoire ; `contact_id` et
/// `follow_up_id` sont facultatifs et vérifiés côté serveur contre le
/// workspace de la session avant écriture — exactement comme
/// `follow_ups.contact_id`. PostgreSQL ne peut pas l'imposer seul ici : une
/// clé étrangère composite (id, workspace_id) interdirait le `SET NULL` à la
/// suppression, dont dépend la conservation des tâches d'un contact supprimé.
model Task {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  contactId   String?   @map("contact_id") @db.Uuid
  followUpId  String?   @map("follow_up_id") @db.Uuid
  title       String
  notes       String?
  dueAt       DateTime  @map("due_at")
  completedAt DateTime? @map("completed_at")
  isDemo      Boolean   @default(false) @map("is_demo")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  followUp  FollowUp? @relation(fields: [followUpId], references: [id], onDelete: SetNull)

  // L'index suit la seule lecture qui compte : les tâches non terminées d'un
  // workspace, de la plus en retard à la plus lointaine.
  @@index([workspaceId, completedAt, dueAt])
  @@index([contactId])
  @@index([followUpId])
  @@map("tasks")
}
