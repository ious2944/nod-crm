// NOD CRM — schéma
// Périmètre : Workspace / Organization / Contact / FollowUp / Task / RGPD Essentials / Commerce.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FollowUpStatus {
  OPEN
  COMPLETED
  ABANDONED
}

enum BallOwner {
  ME
  THEM
}

/// Étapes du pipeline commercial. GAGNEE et PERDUE clôturent l'opportunité.
enum OpportunityStatus {
  A_QUALIFIER
  EN_DISCUSSION
  PROPOSITION
  GAGNEE
  PERDUE
}

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  contacts          Contact[]
  followUps         FollowUp[]
  organizations     Organization[]
  tasks             Task[]
  users             User[]
  opportunities     Opportunity[]
  privacyTreatments PrivacyTreatment[]
  privacyProcessors PrivacyProcessor[]
  privacyRequests   PrivacyRequest[]
  privacyIncidents  PrivacyIncident[]

  @@map("workspaces")
}

/// Un utilisateur appartient à exactement un workspace. Le workspace autorisé
/// est donc entièrement déterminé par la session : il n'est jamais lu depuis
/// une entrée client.
model User {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  email        String    @unique
  /// Argon2id. Ne jamais journaliser, ne jamais renvoyer au client.
  passwordHash String    @map("password_hash")
  displayName  String?   @map("display_name")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessions  Session[]

  @@index([workspaceId])
  @@map("users")
}

/// Session opaque côté serveur. Le cookie ne transporte qu'un jeton aléatoire ;
/// la base ne stocke que son HMAC-SHA256 (clé = AUTH_SECRET). Une fuite de la
/// base seule ne permet donc pas de forger un cookie valide.
model Session {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  /// Expiration absolue : la session meurt même si elle reste active.
  expiresAt     DateTime  @map("expires_at")
  /// Expiration d'inactivité, repoussée au fil des requêtes.
  idleExpiresAt DateTime  @map("idle_expires_at")
  lastUsedAt    DateTime  @default(now()) @map("last_used_at")
  revokedAt     DateTime? @map("revoked_at")
  /// Contexte de création, à des fins de détection d'abus. L'IP est hachée.
  userAgent     String?   @map("user_agent")
  ipHash        String?   @map("ip_hash")
  createdAt     DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Tentatives de connexion, pour la limitation de débit applicative.
/// Aucun mot de passe n'y est stocké ; l'IP est hachée.
model LoginAttempt {
  id         String   @id @default(uuid()) @db.Uuid
  /// Clé de comptage : `email:<adresse>` ou `ip:<empreinte>`.
  scope      String
  successful Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([scope, createdAt])
  @@map("login_attempts")
}

/// Référentiel des entreprises, sociétés et associations (V0.5).
model Organization {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  name        String
  website     String?
  phone       String?
  email       String?
  notes       String?
  archivedAt  DateTime? @map("archived_at")
  isDemo      Boolean   @default(false) @map("is_demo")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts      Contact[]
  opportunities Opportunity[]

  @@index([workspaceId, archivedAt, name])
  @@map("organizations")
}

/// Référentiel central des personnes (V0.2).
model Contact {
  id               String    @id @default(uuid()) @db.Uuid
  workspaceId      String    @map("workspace_id") @db.Uuid
  organizationId   String?   @map("organization_id") @db.Uuid
  firstName        String    @map("first_name")
  lastName         String    @map("last_name")
  email            String?
  phone            String?
  jobTitle         String?   @map("job_title")
  organizationName String?   @map("organization_name")
  notes            String?
  photoKey         String?   @map("photo_key")
  photoMimeType    String?   @map("photo_mime_type")
  archivedAt       DateTime? @map("archived_at")
  isDemo           Boolean   @default(false) @map("is_demo")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  followUps       FollowUp[]
  tasks           Task[]
  opportunities   Opportunity[]
  privacyRequests PrivacyRequest[]

  @@index([workspaceId, archivedAt, firstName, lastName])
  @@index([workspaceId, archivedAt, createdAt])
  @@index([workspaceId, archivedAt, updatedAt])
  @@index([organizationId])
  @@map("contacts")
}

model FollowUp {
  id             String         @id @default(uuid()) @db.Uuid
  workspaceId    String         @map("workspace_id") @db.Uuid
  contactId      String?        @map("contact_id") @db.Uuid
  /// Lien facultatif vers une opportunité commerciale. N'altère pas le
  /// fonctionnement normal du suivi (balle, relance, Today).
  opportunityId  String?        @map("opportunity_id") @db.Uuid
  title          String
  description    String?
  status         FollowUpStatus @default(OPEN)
  ballOwner      BallOwner      @default(THEM) @map("ball_owner")
  dueAt          DateTime       @map("due_at")
  nudgeCount     Int            @default(0) @map("nudge_count")
  lastNudgedAt   DateTime?      @map("last_nudged_at")
  isDemo         Boolean        @default(false) @map("is_demo")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  completedAt    DateTime?      @map("completed_at")

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  tasks       Task[]

  @@index([workspaceId, status, dueAt])
  @@index([contactId])
  @@index([opportunityId])
  @@map("follow_ups")
}

/// Une tâche (V0.4) : quelque chose à faire.
model Task {
  id            String    @id @default(uuid()) @db.Uuid
  workspaceId   String    @map("workspace_id") @db.Uuid
  contactId     String?   @map("contact_id") @db.Uuid
  followUpId    String?   @map("follow_up_id") @db.Uuid
  /// Lien facultatif vers une opportunité commerciale. N'altère pas le
  /// fonctionnement normal de la tâche.
  opportunityId String?   @map("opportunity_id") @db.Uuid
  title         String
  notes         String?
  dueAt         DateTime  @map("due_at")
  completedAt   DateTime? @map("completed_at")
  isDemo        Boolean   @default(false) @map("is_demo")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  followUp    FollowUp?    @relation(fields: [followUpId], references: [id], onDelete: SetNull)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([workspaceId, completedAt, dueAt])
  @@index([contactId])
  @@index([followUpId])
  @@index([opportunityId])
  @@map("tasks")
}

/// Module Commerce (V0.9) — affaire commerciale en cours de négociation.
///
/// Une opportunité décrit l'affaire (qui, combien, où en est-on). Elle ne
/// contient aucune logique de rappel ni d'échéance opérationnelle : ce rôle
/// appartient aux Tâches et aux Suivis liés via `opportunityId`.
model Opportunity {
  id              String            @id @default(uuid()) @db.Uuid
  workspaceId     String            @map("workspace_id") @db.Uuid
  organizationId  String            @map("organization_id") @db.Uuid
  /// Contact principal : doit appartenir au même workspace. Facultatif.
  contactId       String?           @map("contact_id") @db.Uuid
  name            String
  status          OpportunityStatus @default(A_QUALIFIER)
  /// Montant estimé hors taxe, en unité monétaire de l'espace.
  estimatedAmount Decimal?          @map("estimated_amount") @db.Decimal(14, 2)
  /// Date de clôture souhaitée, saisie par l'utilisateur.
  expectedCloseAt DateTime?         @map("expected_close_at")
  /// Horodatage effectif de passage au statut GAGNEE ou PERDUE.
  closedAt        DateTime?         @map("closed_at")
  notes           String?
  isDemo          Boolean           @default(false) @map("is_demo")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  tasks        Task[]
  followUps    FollowUp[]

  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, status, estimatedAmount])
  @@index([organizationId])
  @@index([contactId])
  @@map("opportunities")
}

/// V0.8 — entrée du registre des traitements RGPD.
model PrivacyTreatment {
  id                String    @id @default(uuid()) @db.Uuid
  workspaceId       String    @map("workspace_id") @db.Uuid
  name              String
  purpose           String
  description       String?
  owner             String?
  dataSubjects      String?   @map("data_subjects")
  dataCategories    String?   @map("data_categories")
  legalBasis        String    @default("TO_DETERMINE") @map("legal_basis")
  retentionPeriod   String?   @map("retention_period")
  recipients        String?
  transferOutsideEea String   @default("UNKNOWN") @map("transfer_outside_eea")
  securityMeasures  String?   @map("security_measures")
  lastReviewedAt    DateTime? @map("last_reviewed_at")
  nextReviewAt      DateTime? @map("next_review_at")
  status            String    @default("ACTIVE")
  archivedAt        DateTime? @map("archived_at")
  isDemo            Boolean   @default(false) @map("is_demo")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  workspace  Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  processors PrivacyTreatmentProcessor[]

  @@index([workspaceId, archivedAt, name])
  @@index([workspaceId, nextReviewAt])
  @@map("privacy_treatments")
}

/// V0.8 — prestataire / sous-traitant intervenant sur des données personnelles.
model PrivacyProcessor {
  id                 String    @id @default(uuid()) @db.Uuid
  workspaceId        String    @map("workspace_id") @db.Uuid
  name               String
  service            String
  category           String?
  dataCategories     String?   @map("data_categories")
  purpose            String?
  country            String?
  eeaStatus          String    @default("UNKNOWN") @map("eea_status")
  dpaStatus          String    @default("TO_REVIEW") @map("dpa_status")
  dpaUrl             String?   @map("dpa_url")
  subprocessorsStatus String   @default("UNKNOWN") @map("subprocessors_status")
  notes              String?
  lastReviewedAt     DateTime? @map("last_reviewed_at")
  nextReviewAt       DateTime? @map("next_review_at")
  archivedAt         DateTime? @map("archived_at")
  isDemo             Boolean   @default(false) @map("is_demo")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  workspace  Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  treatments PrivacyTreatmentProcessor[]

  @@index([workspaceId, archivedAt, name])
  @@index([workspaceId, nextReviewAt])
  @@map("privacy_processors")
}

/// Relation N-N entre traitements et sous-traitants. Le workspace est stocké
/// explicitement afin que toutes les opérations restent bornées côté application.
model PrivacyTreatmentProcessor {
  workspaceId String @map("workspace_id") @db.Uuid
  treatmentId String @map("treatment_id") @db.Uuid
  processorId String @map("processor_id") @db.Uuid

  treatment PrivacyTreatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  processor PrivacyProcessor @relation(fields: [processorId], references: [id], onDelete: Cascade)

  @@id([treatmentId, processorId])
  @@index([workspaceId])
  @@index([processorId])
  @@map("privacy_treatment_processors")
}

/// V0.8 — demande d'exercice de droits reçue d'une personne concernée.
model PrivacyRequest {
  id             String    @id @default(uuid()) @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  contactId      String?   @map("contact_id") @db.Uuid
  requesterName  String?   @map("requester_name")
  requesterEmail String?   @map("requester_email")
  requestType    String    @map("request_type")
  receivedAt     DateTime  @map("received_at")
  dueAt          DateTime  @map("due_at")
  status         String    @default("RECEIVED")
  owner          String?
  notes          String?
  closedAt       DateTime? @map("closed_at")
  isDemo         Boolean   @default(false) @map("is_demo")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, dueAt])
  @@index([contactId])
  @@map("privacy_requests")
}

/// V0.8 — registre interne des incidents / violations de données.
model PrivacyIncident {
  id                    String    @id @default(uuid()) @db.Uuid
  workspaceId           String    @map("workspace_id") @db.Uuid
  title                 String
  discoveredAt          DateTime  @map("discovered_at")
  occurredAt            DateTime? @map("occurred_at")
  description           String
  dataCategories        String?   @map("data_categories")
  affectedCount         Int?      @map("affected_count")
  consequences          String?
  measures              String?
  riskLevel             String    @default("TO_ASSESS") @map("risk_level")
  authorityNotification String    @default("TO_ASSESS") @map("authority_notification")
  notifiedAt            DateTime? @map("notified_at")
  peopleInformed        String    @default("TO_ASSESS") @map("people_informed")
  owner                 String?
  status                String    @default("OPEN")
  closedAt              DateTime? @map("closed_at")
  isDemo                Boolean   @default(false) @map("is_demo")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, discoveredAt])
  @@map("privacy_incidents")
}
